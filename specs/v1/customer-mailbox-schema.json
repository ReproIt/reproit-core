{
  "$id": "https://reproit.dev/spec/v1/customer-mailbox-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "pattern": "^cap_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "deployment_digest": { "$ref": "#/$defs/digest" },
        "expires_at": { "format": "date-time", "type": "string" },
        "failure_storm_digest": { "$ref": "#/$defs/digest" },
        "format": { "const": "reproit.candidate-staging-identity.v1" },
        "organization_id": {
          "pattern": "^org_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "processing_mode": { "const": "private" },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "provider_lease_digest": { "$ref": "#/$defs/digest" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "service_id": {
          "pattern": "^svc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "world_id": { "$ref": "#/$defs/digest" }
      },
      "required": [
        "capture_id", "deployment_digest", "expires_at", "failure_storm_digest",
        "format", "organization_id", "processing_mode", "project_id", "provider_lease_digest",
        "request_digest", "service_id", "world_id"
      ],
      "type": "object"
    },
    "envelope": {
      "additionalProperties": false,
      "properties": {
        "cipher_digest": { "$ref": "#/$defs/digest" },
        "cipher_size": { "maximum": 1048604, "minimum": 28, "type": "integer" },
        "ciphertext": {
          "maxLength": 1398139,
          "minLength": 38,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "format": { "const": "reproit.candidate-staging-envelope.v1" },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "required": ["cipher_digest", "cipher_size", "ciphertext", "format", "identity"],
      "type": "object"
    },
    "object": {
      "additionalProperties": false,
      "properties": {
        "cipher_digest": { "$ref": "#/$defs/digest" },
        "cipher_size": { "maximum": 1048604, "minimum": 28, "type": "integer" },
        "media_type": {
          "const": "application/vnd.reproit.candidate-staging-ciphertext.v1"
        },
        "object_identity": { "$ref": "#/$defs/digest" }
      },
      "required": ["cipher_digest", "cipher_size", "media_type", "object_identity"],
      "type": "object"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "content": {
          "additionalProperties": false,
          "properties": {
            "envelope": { "$ref": "#/$defs/envelope" },
            "kind": { "const": "CIPHERTEXT" }
          },
          "required": ["envelope", "kind"],
          "type": "object"
        },
        "format": { "const": "reproit.candidate-mailbox-item.v1" },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "required": ["content", "format", "identity"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "content": {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "OBJECT" },
            "object": { "$ref": "#/$defs/object" }
          },
          "required": ["kind", "object"],
          "type": "object"
        },
        "format": { "const": "reproit.candidate-mailbox-item.v1" },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "required": ["content", "format", "identity"],
      "type": "object"
    }
  ]
}
